/Makefile @ENTERPILOT/maintainers
/helm/ @ENTERPILOT/maintainers

# Dependency manifests and lockfiles
/go.mod @ENTERPILOT/maintainers
/go.sum @ENTERPILOT/maintainers
/web/dashboard/package.json @ENTERPILOT/maintainers
/web/dashboard/package-lock.json @ENTERPILOT/maintainers

