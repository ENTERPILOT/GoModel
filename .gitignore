# Compiled binary
/gomodel
/recordapi
/bin

# Environment variables
/.env

# User config (created from config/config.example.yaml)
/config/config.yaml

# Cache
/.cache
/tests/integration/.cache/*
!/tests/integration/.cache/.gitkeep

# Data (runtime-created by SQLite storage)
/data/

# Helm chart dependencies
**/charts/*.tgz

# OpenCode config - ignore because it might contain private servers URLs
/opencode.json

# Local git worktrees
/.worktrees/

# Local pre-commit hook (not shared)
/.githooks/

# Others
/*.bck.yml
/repomix-output.*
/coverage.out
/.claude/

# Superpower design docs and plans (never commit)
/docs/superpowers/

# Dashboard frontend. The Vite build output is produced by `make frontend`
# locally and by the CI `frontend` job; see docs/adr/0010-dashboard-built-in-ci.md.
/web/dashboard/node_modules/
/internal/admin/dashboard/static/dist/

# Example plugin shared objects built by `make example-plugins`.
/plugins/
