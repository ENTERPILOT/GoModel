{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "target": "ES2022",
    "module": "ES2022",
    "checkJs": false,
    "allowJs": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "$lib/*": ["src/lib/*"],
      "$pages/*": ["src/pages/*"]
    }
  },
  "include": ["src/**/*.js", "src/**/*.svelte"]
}
